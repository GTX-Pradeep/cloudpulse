# Copy to .env and change the password. .env is git-ignored.
POSTGRES_USER=cloudpulse
POSTGRES_PASSWORD=change_me

# Connection strings used by the CloudPulse Python code.
CP_TARGET_DSN=postgresql://cloudpulse:change_me@localhost:5433/target
CP_LAB_DSN=postgresql://cloudpulse:change_me@localhost:5434/lab
CP_META_DSN=postgresql://cloudpulse:change_me@localhost:5435/cloudpulse

# Label written into every results file. Use "official" only for runs on the
# machine whose results you intend to publish.
CP_ENV_LABEL=local
