{
  "spec": {
    "name": "cand7_segment_revenue_for_status",
    "description": "ANALYZE orders",
    "scale": "default",
    "seed": 42,
    "baseline_sql": [
      "CREATE INDEX orders_customer_id_idx ON orders (customer_id)",
      "CREATE INDEX orders_created_at_idx ON orders (created_at)",
      "CREATE INDEX orders_updated_at_idx ON orders (updated_at)",
      "ANALYZE orders",
      "ALTER TABLE orders SET (autovacuum_enabled = false)",
      "INSERT INTO orders (id, customer_id, status, amount, created_at, updated_at) SELECT m.max_id + g, 1 + (g::bigint * 7919) % m.n_customers, 'backordered', 10, timestamptz '2025-12-20' + g * interval '1 second', timestamptz '2025-12-20' + g * interval '1 second' FROM (SELECT (SELECT max(id) FROM orders) AS max_id,              (SELECT count(*) FROM customers) AS n_customers) m, generate_series(1, 300000) g"
    ],
    "queries": [
      {
        "name": "segment_revenue_for_status",
        "sql": "SELECT c.segment, count(*), sum(o.amount) FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.status = %s GROUP BY c.segment",
        "kind": "read",
        "params": {
          "type": "values",
          "values": [
            [
              "backordered"
            ],
